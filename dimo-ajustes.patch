diff --git a/src/index.css b/src/index.css
index 030b5ba..f971047 100644
--- a/src/index.css
+++ b/src/index.css
@@ -120,15 +120,30 @@ header,
   text-rendering: optimizeLegibility;
 }
 
-/* Sharp vector rendering & smooth subpixel anti-aliasing */
+/* Sharp vector rendering.
+   `geometricPrecision` (the previous value here) tells the renderer to favor
+   geometric/curve precision OVER crisp edges — it is the literal opposite of
+   "sharp" despite the old comment. On thin 1.5–2px strokes (the toolbar nav
+   icons) that extra anti-aliasing reads as blur specifically once the page is
+   composited without Safari's own chrome (i.e. in standalone/PWA mode).
+   crispEdges disables that edge anti-aliasing outright, which also suits the
+   RPG pixel-art icons better. */
 svg {
-  shape-rendering: geometricPrecision;
+  shape-rendering: crispEdges;
 }
 
-.crisp-nav-icon {
-  -webkit-font-smoothing: antialiased;
-  -moz-osx-font-smoothing: grayscale;
-  text-rendering: optimizeLegibility;
+/* `.crisp-nav-icon` previously only set font-smoothing/text-rendering, which
+   have no effect on <svg> — they're text properties, not vector ones, so the
+   class never actually sharpened anything. Give the toolbar icons their own
+   GPU compositing layer instead, so iOS/WKWebView rasterizes them at the
+   display's native pixel scale rather than inheriting whatever (possibly
+   fractional) scale the standalone document's shared layer ends up with. */
+.crisp-nav-icon,
+.toolbar-container svg {
+  -webkit-transform: translateZ(0);
+  transform: translateZ(0);
+  -webkit-backface-visibility: hidden;
+  backface-visibility: hidden;
 }
 
 /* Pixel art rendering utility */
